FROM node:24-slim AS frontend

WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.11-slim AS api

WORKDIR /app

COPY backend/pyproject.toml backend/alembic.ini ./
COPY backend/app ./app
COPY backend/migrations ./migrations
# The release scan blocks any HIGH or CRITICAL finding that has a fix, and
# base images lag both their distribution's updates and setuptools' vendored
# wheel and jaraco.context.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y && rm -rf /var/lib/apt/lists/* \
	&& pip install --no-cache-dir --upgrade setuptools && pip install --no-cache-dir .

COPY --from=frontend /build/build /app/static

ENV FRONTEND_DIST=/app/static

EXPOSE 8080

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--ws-max-size", "2097152"]
