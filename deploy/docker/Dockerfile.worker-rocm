FROM python:3.11-slim

# torch in rocm/pytorch:rocm7.0.2 has no gfx1102 (RX 7600) kernels: a real
# generation failed with "invalid device function". The rocm6.3 wheels carry
# their own ROCm libraries and kernels for gfx1030-gfx1201, the same build
# `make setup-rocm` installs, so the base needs no ROCm userspace.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir torch==2.9.1 torchvision==0.24.1 --index-url https://download.pytorch.org/whl/rocm6.3

COPY worker/pyproject.toml .
COPY worker/worker ./worker
COPY worker/vendor ./vendor
# Bundled manifests sit beside the package: worker/manifests.py reads ./models.
COPY worker/models ./models

RUN pip install --no-cache-dir ".[inference]" \
	&& pip install --no-cache-dir --upgrade setuptools wheel 'filelock>=4.2.1'

ENV DEVICE=rocm
ENV PYTHONUNBUFFERED=1

# Starts as root, or as the host cache owner when WORKER_UID is set (deploy/docker/worker-entrypoint.sh).
COPY deploy/docker/worker-entrypoint.sh /usr/local/bin/worker-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/worker-entrypoint.sh"]
CMD ["python", "-m", "worker"]
