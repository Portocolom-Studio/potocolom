POSTGRES_PASSWORD=change-me
# Shared secret for the API fleet socket and all workers. scripts/preflight.sh
# writes this file on first run and fills POSTGRES_PASSWORD and FLEET_SECRET
# with openssl rand -hex 32. Hex is mandatory: Compose expands $NAME in an
# unquoted value, and the secret travels in an HTTP header (ASCII only).
# An empty FLEET_SECRET refuses to start the API; copy FLEET_SECRET to a
# worker on another machine as FLEET_TOKEN.
# Generate with: openssl rand -hex 32
FLEET_SECRET=
# Hugging Face read token, only needed for gated models (sd35-medium).
# Accept the model license on huggingface.co first, then paste the token here.
HF_TOKEN=
TELEMETRY=true

# Where browsers reach this install. Change it if you serve the studio on a LAN
# address: it is the allowlist for the WebSocket endpoints and the base for
# image URLs, so leaving it as localhost breaks both from another machine.
PUBLIC_URL=http://localhost:8080

# Accounts. AUTH_MODE=none is the default and resolves every request to one
# implicit local administrator, which is what a single-operator install wants.
# `make auth-enable` switches this to accounts, writes ROOT_KEYS below, and
# prints a one-use link that claims the administrator account. Enabling
# accounts is one way: the install refuses to start in none mode afterwards.
AUTH_MODE=none
# Versioned root key ring for account secrets, comma separated version:base64key
# entries, newest first. The first entry is the active write key and every entry
# stays readable, so rotation prepends a new version, re-encrypts, then drops the
# old one. Separate key material from FLEET_SECRET. `make auth-enable` fills it.
# Generate with: openssl rand -base64 32
ROOT_KEYS=
# Extra browser origins allowed to open the WebSocket endpoints, comma separated.
# Only needed when the studio is served from a different origin than the API.
ALLOWED_ORIGINS=
