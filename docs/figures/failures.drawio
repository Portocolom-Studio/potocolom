ht="20" as="geometry"/></mxCell><mxCell id="cap7" value="turned" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="200" y="262" width="144" height="20" as="geometry"/></mxCell><mxCell id="v8" value="score 2 · the turn is confused" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=none;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="292" width="304" height="34" as="geometry"/></mxCell><mxCell id="l9" value="Upright is a clean elephant." style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="304" height="20" as="geometry"/></mxCell><mxCell id="l10" value="Turned, swan and elephant overlap." style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="304" height="20" as="geometry"/></mxCell><mxCell id="p11" value="seed 37 · joint · oil" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="382" width="304" height="18" as="geometry"/></mxCell><mxCell id="u12" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;imageBorder=#c9cdd6;" vertex="1" parent="1"><mxGeometry x="368" y="112" width="144" height="144" as="geometry"/></mxCell><mxCell id="t13" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;imageBorder=#c9cdd6;" vertex="1" parent="1"><mxGeometry x="528" y="112" width="144" height="144" as="geometry"/></mxCell><mxCell id="cap14" value="upright" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="368" y="262" width="144" height="20" as="geometry"/></mxCell><mxCell id="cap15" value="turned" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="528" y="262" width="144" height="20" as="geometry"/></mxCell><mxCell id="v16" value="score 0 · only the turn reads" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=none;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="368" y="292" width="304" height="34" as="geometry"/></mxCell><mxCell id="l17" value="Upright resolves into nothing." style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="368" y="336" width="304" height="20" as="geometry"/></mxCell><mxCell id="l18" value="Turned, the swan is clean." style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="368" y="356" width="304" height="20" as="geometry"/></mxCell><mxCell id="p19" value="seed 23 · independent · oil" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="368" y="382" width="304" height="18" as="geometry"/></mxCell><mxCell id="u20" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;imageBorder=#c9cdd6;" vertex="1" parent="1"><mxGeometry x="696" y="112" width="144" height="144" as="geometry"/></mxCell><mxCell id="t21" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;imageBorder=#c9cdd6;" vertex="1" parent="1"><mxGeometry x="856" y="112" width="144" height="144" as="geometry"/></mxCell><mxCell id="cap22" value="upright" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="696" y="262" width="144" height="20" as="geometry"/></mxCell><mxCell id="cap23" value="turned" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="856" y="262" width="144" height="20" as="geometry"/></mxCell><mxCell id="v24" value="score 5 · cut on the frame flag" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=none;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="696" y="292" width="304" height="34" as="geometry"/></mxCell><mxCell id="l25" value="Both subjects read here." style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="696" y="336" width="304" height="20" as="geometry"/></mxCell><mxCell id="l26" value="Pencils and a desk are painted in." style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="696" y="356" width="304" height="20" as="geometry"/></mxCell><mxCell id="p27" value="seed 11 · independent · sketch" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="696" y="382" width="304" height="18" as="geometry"/></mxCell><mxCell id="why28" value="&lt;b&gt;the score and the frame flag are two separate judgements&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;The score asks whether both subjects read. The frame flag asks whether the image pretends to be a photo of a drawing.&lt;br&gt;A cell needs 4 or 5 on the score and no disqualifying frame. The third cell scored 5 and was still cut.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#c9cdd6;strokeWidth=1.2;fontFamily=Lato;fontSize=17;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="424" width="960" height="108" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>