Color=#f5f5f5;endArrow=block;endFill=1;endSize=7;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dp10" target="d4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="435"/></Array></mxGeometry></mxCell><mxCell id="eq17" value="\(\mathcal{L}_{\mathrm{DT}}=\big(1-\mathrm{SSIM}(d,\tilde d)\big)+\lVert d-\tilde d\rVert_2^2\)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="380" y="242" width="340" height="34" as="geometry"/></mxCell><mxCell id="dn18" value="The gallery ran one round at \(t_0=0.95\,T\). The default runs eight, with \(t_0\) falling to \(0.05\,T\); extra rounds made images worse." style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#4f5d75;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="380" y="278" width="340" height="60" as="geometry"/></mxCell><mxCell id="pl19" value="(b)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="564" width="40" height="22" as="geometry"/></mxCell><mxCell id="panel20" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cdd6;strokeWidth=1;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="592" width="960" height="240" as="geometry"/></mxCell><mxCell id="pt21" value="What SDEdit starts from at \(t_0=0.95\,T\)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="604" width="920" height="20" as="geometry"/></mxCell><mxCell id="sh22" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;imageBorder=#c9cdd6;" vertex="1" parent="1"><mxGeometry x="72" y="632" width="150" height="150" as="geometry"/></mxCell><mxCell id="cap23" value="\(d\)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="42" y="790" width="210" height="20" as="geometry"/></mxCell><mxCell id="sh24" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;imageBorder=#c9cdd6;" vertex="1" parent="1"><mxGeometry x="292" y="632" width="150" height="150" as="geometry"/></mxCell><mxCell id="cap25" value="\(\sqrt{\bar\alpha_{t_0}}\,d+\sqrt{1-\bar\alpha_{t_0}}\,\epsilon\)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="262" y="790" width="210" height="20" as="geometry"/></mxCell><mxCell id="l26" value="" style="html=1;rounded=0;strokeColor=#2d3142;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="232.0" y="707" as="sourcePoint"/><mxPoint x="284.0" y="707" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sh27" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;imageBorder=#c9cdd6;" vertex="1" parent="1"><mxGeometry x="512" y="632" width="150" height="150" as="geometry"/></mxCell><mxCell id="cap28" value="\(\tilde d\)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="482" y="790" width="210" height="20" as="geometry"/></mxCell><mxCell id="l29" value="" style="html=1;rounded=0;strokeColor=#2d3142;strokeWidth=1.4;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="452.0" y="707" as="sourcePoint"/><mxPoint x="504.0" y="707" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sn30" value="\(\bar\alpha_{t_0}\approx 0.008\) under SD 1.5&#x27;s schedule, so about 9 percent of the signal amplitude survives. The target keeps the rough layout of \(d\) and redraws everything else. Noise is shown in pixel space for illustration." style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="740" y="640" width="240" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>