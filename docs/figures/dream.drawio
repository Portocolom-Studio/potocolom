<mxfile host="potocolom" type="device"><diagram name="figure" id="fig"><mxGraphModel dx="1040" dy="884" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="1" shadow="0" background="#f5f5f5"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg1" value="" style="rounded=0;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=none;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=10;locked=1;movable=0;resizable=0;selectable=0;editable=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1040" height="864" as="geometry"/></mxCell><mxCell id="title2" value="Dream it, then match it" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=24;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="960" height="32" as="geometry"/></mxCell><mxCell id="pl3" value="(a)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="40" height="22" as="geometry"/></mxCell><mxCell id="d4" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;imageBorder=#c9cdd6;" vertex="1" parent="1"><mxGeometry x="88" y="130" width="150" height="150" as="geometry"/></mxCell><mxCell id="dl5" value="\(d\) · the view entering Dream" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#2d3142;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="88" y="104" width="260" height="20" as="geometry"/></mxCell><mxCell id="sd6" value="&lt;b&gt;SDEdit, frozen&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;\(\tilde d=\mathrm{SDEdit}(d;\,t_0,\,y)\)&lt;br&gt;DreamShaper LCM, CFG 2&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=17;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="400" y="104" width="240" height="104" as="geometry"/></mxCell><mxCell id="z7" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;imageBorder=#c9cdd6;" vertex="1" parent="1"><mxGeometry x="850" y="130" width="150" height="150" as="geometry"/></mxCell><mxCell id="zl8" value="\(\tilde d\) · the target, frozen for the round" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#2d3142;fontStyle=0;align=right;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="690" y="104" width="310" height="20" as="geometry"/></mxCell><mxCell id="reg9" value="&lt;b&gt;regress the view onto the target&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;\(\min_\theta\ \mathcal{L}_{\mathrm{DT}}(d,\tilde d)\)&lt;br&gt;300 steps, fresh Adam, \(\eta=3\times10^{-3}\)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=17;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="640" y="384" width="280" height="104" as="geometry"/></mxCell><mxCell id="dp10" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;imageBorder=#c9cdd6;" vertex="1" parent="1"><mxGeometry x="200" y="360" width="150" height="150" as="geometry"/></mxCell><mxCell id="dpl11" value="\(d&#x27;\) · after the round" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#2d3142;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">