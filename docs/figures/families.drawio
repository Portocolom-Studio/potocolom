<mxfile host="potocolom" type="device"><diagram name="figure" id="fig"><mxGraphModel dx="1040" dy="1382" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#f5f5f5"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="bg1" value="" style="rounded=0;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=none;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=10;locked=1;movable=0;resizable=0;selectable=0;editable=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1040" height="1362.0" as="geometry" /></mxCell><mxCell id="title3" value="Two ways to make one image read twice" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=24;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="28.0" width="960" height="32" as="geometry" /></mxCell><mxCell id="sw4" value="" style="rounded=0;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6effc;strokeColor=#005ee3;strokeWidth=1;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="841.2" y="40.0" width="14" height="14" as="geometry" /></mxCell><mxCell id="lg5" value="what this page does" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="863.2" y="37.0" width="136.8" height="20" as="geometry" /></mxCell><mxCell id="sw6" value="" style="rounded=0;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#c9cdd6;strokeWidth=1;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="682.0" y="40.0" width="14" height="14" as="geometry" /></mxCell><mxCell id="lg7" value="the other family" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="704.0" y="37.0" width="115.19999999999999" height="20" as="geometry" /></mxCell><mxCell id="lh8" value="sampling time" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#c9cdd6;strokeWidth=1.2;fontFamily=Lato;fontSize=17;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="92.0" width="464" height="44" as="geometry" /></mxCell><mxCell id="rh9" value="optimisation time · this page" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6effc;strokeColor=#005ee3;strokeWidth=1.2;fontFamily=Lato;fontSize=17;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="536" y="92.0" width="464" height="44" as="geometry" /></mxCell><mxCell id="l10" value="&lt;b&gt;one reverse diffusion pass&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;no image parameters are trained&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cdd6;strokeWidth=1.2;fontFamily=Lato;fontSize=17;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="152.0" width="464" height="84" as="geometry" /></mxCell><mxCell id="r11" value="&lt;b&gt;thousands of optimiser steps&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;a prime network is trained&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#005ee3;strokeWidth=1.2;fontFamily=Lato;fontSize=17;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="536" y="152.0" width="464" height="84" as="geometry" /></mxCell><mxCell id="l12" value="&lt;b&gt;at each step&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;score each view, undo the view,&lt;br&gt;average the estimates, denoise&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cdd6;strokeWidth=1.2;fontFamily=Lato;fontSize=17;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="248.0" width="464" height="84" as="geometry" /></mxCell><mxCell id="r13" value="&lt;b&gt;at each step&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;render the views, score each one,&lt;br&gt;push the residual back into θ&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#005ee3;strokeWidth=1.2;fontFamily=Lato;fontSize=17;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="536" y="248.0" width="464" height="84" as="geometry" /></mxCell><mxCell id="l14" value="&lt;b&gt;the cost&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;one sampling pass, seconds&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cdd6;strokeWidth=1.2;fontFamily=Lato;fontSize=17;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="344.0" width="464" height="84" as="geometry" /></mxCell><mxCell id="r15" value="&lt;b&gt;the cost&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;5000 SDS steps, 26 minutes on one card,&lt;br&gt;then a Dream round of 88 seconds&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#005ee3;strokeWidth=1.2;fontFamily=Lato;fontSize=17;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="536" y="344.0" width="464" height="84" as="geometry" /></mxCell><mxCell id="l16" value="&lt;b&gt;the constraint&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;views must be orthogonal transforms:&lt;br&gt;flips, rotations, pixel permutations&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cdd6;strokeWidth=1.2;fontFamily=Lato;fontSize=17;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="440.0" width="464" height="84" as="geometry" /></mxCell><mxCell id="r17" value="&lt;b&gt;the constraint&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;the arrangement only has to be&lt;br&gt;differentiable, so overlays are in scope&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#005ee3;strokeWidth=1.2;fontFamily=Lato;fontSize=17;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="536" y="440.0" width="464" height="84" as="geometry" /></mxCell><mxCell id="cite18" value="Visual Anagrams (Geng, Park and Owens, arXiv 2311.17919) is the sampling-time family. Diffusion Illusions (Burgert et al.) is this one." style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#c9cdd6;strokeWidth=1.2;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="536.0" width="960" height="44" as="geometry" /></mxCell><mxCell id="l19" value="" style="html=1;rounded=0;strokeColor=#c9cdd6;strokeWidth=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40.0" y="600.0" as="sourcePoint" /><mxPoint x="1000.0" y="600.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="band20" value="THE SAME FAMILY, A DIFFERENT ARRANGEMENT" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#005ee3;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="612.0" width="960" height="20" as="geometry" /></mxCell><mxCell id="bandtext21" value="Optimise the same way, but make the arrangement a 3D renderer, and the sheet becomes a sphere, a cube or a reflective cylinder. The constraint was never the flip. It was that the arrangement stays differentiable." style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=15;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="636.0" width="960" height="44" as="geometry" /></mxCell><mxCell id="i3d22" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;imageBorder=#c9cdd6;" vertex="1" parent="1"><mxGeometry x="40" y="692.0" width="960" height="594" as="geometry" /></mxCell><mxCell id="credit23" value="Illusion3D: 3D Multiview Illusion with 2D Diffusion Priors · Feng, Sanjay, Lutz, AlBahar, Ge and Huang · arXiv 2412.09625, Figure 1, cropped · CC BY 4.0, creativecommons.org/licenses/by/4.0" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1294.0" width="960" height="36" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>