<mxfile host="potocolom"><diagram name="figure" id="fig"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="880" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=none;locked=1;" vertex="1" parent="1"><mxGeometry width="1100" height="880" as="geometry"/></mxCell><mxCell id="title1" value="Human review is the gate - a score alone never made the cut" style="text;html=1;fontFamily=Helvetica;fontSize=26;fontStyle=1;fontColor=#0f172a;align=left;verticalAlign=top;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1060" height="34" as="geometry"/></mxCell><mxCell id="sub2" value="Every baked cell went past one blind human reviewer. Two judgements decide it: the score, then the frame flag. CLIP is logged beside the gate, never in it." style="text;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#64748b;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="1060" height="44" as="geometry"/></mxCell><mxCell id="lane3" value="&lt;b&gt;The funnel - 206 baked cells, one human decision each&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=48;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="1060" height="340" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;206 cells&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#e2e8f0&quot;&gt;98 bases x&lt;br&gt;4 Dream arms&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#ffffff;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="150" height="72" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;blind review&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#475569&quot;&gt;score 0 to 5&lt;br&gt;+ frame flag&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="220" y="200" width="170" height="72" as="geometry"/></mxCell><mxCell id="d6" value="score 4 or 5?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="420" y="186" width="160" height="100" as="geometry"/></mxCell><mxCell id="d7" value="frame flag disqualifying?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="675" y="176" width="200" height="120" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;26 keepers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#e2e8f0&quot;&gt;passed both gates&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#ffffff;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="920" y="200" width="140" height="72" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#64748b;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="d6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="yes - 43" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#10b981;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d6" target="d7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t12" value="21 fours&lt;br&gt;22 fives" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#475569;fontStyle=0;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="585" y="250" width="100" height="40" as="geometry"/></mxCell><mxCell id="e13" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#10b981;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n14" value="&lt;b&gt;cut on the score&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#e2e8f0&quot;&gt;score 0 to 3&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f43f5e;strokeColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#ffffff;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="420" y="350" width="160" height="64" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;16 cut&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#e2e8f0&quot;&gt;frame defect&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f43f5e;strokeColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#ffffff;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="690" y="350" width="170" height="64" as="geometry"/></mxCell><mxCell id="e16" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#f43f5e;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#be123c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d6" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#f43f5e;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#be123c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d7" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="&lt;b&gt;CLIP pair score&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#475569&quot;&gt;ROC-AUC 0.706, bar 0.75&lt;br&gt;recorded, never a gate&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="200" y="340" width="200" height="84" as="geometry"/></mxCell><mxCell id="e19" value="logged" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#94a3b8;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#64748b;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="n5" target="n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="code20" value="window2-2026-08-clean" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;fontFamily=Courier New;fontSize=12;fontColor=#f8fafc;align=center;" vertex="1" parent="1"><mxGeometry x="900" y="356" width="170" height="44" as="geometry"/></mxCell><mxCell id="e21" value="export" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#94a3b8;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#64748b;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="n8" target="code20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lane22" value="&lt;b&gt;Same pair, same seed, both scored 5 - one cut, one kept&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=48;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.2;fontFamily=Helvetica;fontSize=16;fontColor=#0f172a;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="1060" height="375" as="geometry"/></mxCell><mxCell id="img23" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/jpeg,;imageBorder=#cbd5e1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="50" y="560" width="200" height="200" as="geometry"/></mxCell><mxCell id="img24" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/jpeg,;imageBorder=#cbd5e1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="290" y="560" width="200" height="200" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;cut&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal;color:#e2e8f0&quot;&gt;score 5 - frame disqualifying&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f43f5e;strokeColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#ffffff;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="50" y="772" width="200" height="56" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;kept&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal;color:#e2e8f0&quot;&gt;score 5 - frame none&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#ffffff;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="290" y="772" width="200" height="56" as="geometry"/></mxCell><mxCell id="t27" value="seed 11 - sketch - independent" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#475569;fontStyle=0;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="532" width="200" height="22" as="geometry"/></mxCell><mxCell id="t28" value="seed 11 - oil - joint" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#475569;fontStyle=0;align=center;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="290" y="532" width="200" height="22" as="geometry"/></mxCell><mxCell id="note29" value="&lt;b style=&#x27;font-size:16px&#x27;&gt;what a frame defect is&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;p style=&#x27;margin:0 0 8px 0&#x27;&gt;A printed border, a torn sheet edge, a desk, or a signature that the model painted into the image.&lt;/p&gt;&lt;p style=&#x27;margin:0 0 8px 0&#x27;&gt;The subject can read perfectly and the cell still goes: the artifact says it is a photo of a drawing.&lt;/p&gt;&lt;p style=&#x27;margin:0 0 8px 0&#x27;&gt;Same pair, same seed, both scored 5.&lt;/p&gt;" style="rounded=1;absoluteArcSize=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#eab308;strokeWidth=1.2;fontFamily=Helvetica;fontSize=14;fontColor=#854d0e;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1"><mxGeometry x="530" y="540" width="520" height="288" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>