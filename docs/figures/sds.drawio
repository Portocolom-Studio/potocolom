gt;G and the objective in one flag&lt;br&gt;--view-batch-size splits the one forward into chunks&lt;br&gt;sds_gradient_scale scaled r by 0.1 for this gallery&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#c9cdd6;strokeWidth=1.2;fontFamily=Lato;fontSize=17;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="528" y="284.0" width="472" height="156" as="geometry" /></mxCell><mxCell id="panel28" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="464.0" width="472" height="300" as="geometry" /></mxCell><mxCell id="pt29" value="TIMESTEP WEIGHT   W(T) = 1 − ᾹT" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="64" y="478.0" width="424" height="20" as="geometry" /></mxCell><mxCell id="win30" value="" style="rounded=0;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbeee7;strokeColor=none;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="103.84" y="528.0" width="376.32" height="156" as="geometry" /></mxCell><mxCell id="cap31" value="sampled window: 2% to 98% of the schedule" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#eb6c36;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="96" y="500.0" width="392" height="20" as="geometry" /></mxCell><mxCell id="l32" value="" style="html=1;rounded=0;strokeColor=#c9cdd6;strokeWidth=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="96.0