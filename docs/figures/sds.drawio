<mxfile host="potocolom" type="device"><diagram name="figure" id="fig"><mxGraphModel dx="1040" dy="1084" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="1" shadow="0" background="#f5f5f5"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg1" value="" style="rounded=0;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=none;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=10;locked=1;movable=0;resizable=0;selectable=0;editable=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1040" height="1064" as="geometry"/></mxCell><mxCell id="title2" value="Noise in, gradient out" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=24;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="960" height="32" as="geometry"/></mxCell><mxCell id="sw3" value="" style="rounded=0;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cdd6;strokeWidth=1;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="870.0" y="40" width="14" height="14" as="geometry"/></mxCell><mxCell id="lg4" value="frozen or fixed" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="892.0" y="37" width="108.0" height="20" as="geometry"/></mxCell><mxCell id="sw5" value="" style="rounded=0;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6effc;strokeColor=#005ee3;strokeWidth=1;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="761.2" y="40" width="14" height="14" as="geometry"/></mxCell><mxCell id="lg6" value="trainable" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="783.2" y="37" width="64.8" height="20" as="geometry"/></mxCell><mxCell id="pl7" value="(a)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="40" height="22" as="geometry"/></mxCell><mxCell id="theta8" value="&lt;b&gt;\(\theta\)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;weights&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6effc;strokeColor=#005ee3;strokeWidth=1.2;fontFamily=Lato;fontSize=18;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="72" height="88" as="geometry"/></mxCell><mxCell id="render9" value="&lt;b&gt;\(p=g_\theta(v)\)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;\(d_i=a_i(p)\)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="134" y="100" width="116" height="88" as="geometry"/></mxCell><mxCell id="d10" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;imageBorder=#c9cdd6;" vertex="1" parent="1"><mxGeometry x="272" y="100" width="88" height="88" as="geometry"/></mxCell><mxCell id="cap11" value="\(d_i\)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#7a8399;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="256" y="192" width="120" height="20" as="geometry"/></mxCell><mxCell id="vae12" value="&lt;b&gt;\(z=\mathcal{E}(\uparrow d_i)\)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;\(4\times64\times64\)&lt;br&gt;frozen, not cut&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="382" y="100" width="132" height="88" as="geometry"/></mxCell><mxCell id="noise13" value="&lt;b&gt;add noise&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;\(z_t=\sqrt{\bar\alpha_t}\,z+\sqrt{1-\bar\alpha_t}\,\epsilon\)&lt;br&gt;DDPM Eq. 4&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="536" y="100" width="164" height="88" as="geometry"/></mxCell><mxCell id="unet14" value="&lt;b&gt;UNet \(\hat\epsilon_\phi\)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;one CFG-doubled pass&lt;br&gt;weights \(\phi\) frozen&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="722" y="100" width="140" height="88" as="geometry"/></mxCell><mxCell id="resid15" value="&lt;b&gt;\(r\)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;\(w(t)(\hat\epsilon_s-\epsilon)\)&lt;br&gt;under \(\mathrm{sg}\)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=17;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="884" y="100" width="116" height="88" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#f5f5f5;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="theta8" target="render9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#f5f5f5;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="render9" target="d10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#f5f5f5;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="d10" target="vae12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#f5f5f5;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="vae12" target="noise13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#f5f5f5;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="noise13" target="unet14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#f5f5f5;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="unet14" target="resid15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l22" value="" style="html=1;rounded=0;strokeColor=#005ee3;strokeWidth=2;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="76.0" y="188" as="sourcePoint"/><mxPoint x="448.0" y="188" as="targetPoint"/><Array as="points"><mxPoint x="76.0" y="224"/><mxPoint x="448.0" y="224"/></Array></mxGeometry></mxCell><mxCell id="cap23" value="gradient path: \(\theta\) to \(z\)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#005ee3;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="150" y="228" width="220" height="20" as="geometry"/></mxCell><mxCell id="l24" value="" style="html=1;rounded=0;strokeColor=#b4232a;strokeWidth=2.4;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="711.0" y="104" as="sourcePoint"/><mxPoint x="711.0" y="184" as="targetPoint"/></mxGeometry></mxCell><mxCell id="cap25" value="\(\mathrm{sg}\): no gradient past here" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#b4232a;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="560" y="78" width="300" height="20" as="geometry"/></mxCell><mxCell id="pl26" value="(b)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="266" width="40" height="22" as="geometry"/></mxCell><mxCell id="panel27" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cdd6;strokeWidth=1;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="292" width="960" height="300" as="geometry"/></mxCell><mxCell id="pt28" value="Why no gradient passes through the UNet" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="304" width="920" height="20" as="geometry"/></mxCell><mxCell id="eq29" value="\(\nabla_\theta\mathcal{L}_{\mathrm{Diff}}=\mathbb{E}_{t,\epsilon}\Big[w(t)\,\underbrace{(\hat\epsilon_\phi(z_t;y,t)-\epsilon)}_{\text{noise residual}}\;\underbrace{{\color{#b4232a}\cancel{\tfrac{\partial\hat\epsilon_\phi(z_t;y,t)}{\partial z_t}}}}_{\text{U-Net Jacobian, omitted}}\;\underbrace{\tfrac{\partial x}{\partial\theta}}_{\text{generator Jacobian}}\Big]\)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=19;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="324" width="872" height="88" as="geometry"/></mxCell><mxCell id="eqn30" value="(1)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=15;fontColor=#4f5d75;fontStyle=0;align=right;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="936" y="324" width="44" height="88" as="geometry"/></mxCell><mxCell id="eqc31" value="DreamFusion Eq. 2: the gradient of the diffusion training loss" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="872" height="16" as="geometry"/></mxCell><mxCell id="drop32" value="DreamFusion drops the U-Net Jacobian: it is expensive, and poorly conditioned at small noise levels. What remains is Score Distillation:" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#4f5d75;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="432" width="920" height="20" as="geometry"/></mxCell><mxCell id="eq33" value="\(\nabla_\theta\mathcal{L}_{\mathrm{SDS}}=\mathbb{E}_{t,\epsilon}\Big[w(t)\,(\hat\epsilon_s-\epsilon)\,\frac{\partial z}{\partial\theta}\Big]\)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=19;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="458" width="872" height="52" as="geometry"/></mxCell><mxCell id="eqn34" value="(2)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=15;fontColor=#4f5d75;fontStyle=0;align=right;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="936" y="458" width="44" height="52" as="geometry"/></mxCell><mxCell id="eqc35" value="DreamFusion Eq. 3, in latent form, with the guided estimate \(\hat\epsilon_s\)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="508" width="872" height="16" as="geometry"/></mxCell><mxCell id="eq36" value="\(\mathcal{L}=\big\langle\,\mathrm{sg}[w(t)(\hat\epsilon_s-\epsilon)],\ z\,\big\rangle\quad\Longrightarrow\quad\nabla_z\mathcal{L}=w(t)(\hat\epsilon_s-\epsilon)\)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=18;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="526" width="872" height="44" as="geometry"/></mxCell><mxCell id="eqn37" value="(3)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=15;fontColor=#4f5d75;fontStyle=0;align=right;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="936" y="526" width="44" height="44" as="geometry"/></mxCell><mxCell id="eqc38" value="the surrogate the code backpropagates; sg is stop-gradient" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="568" width="872" height="16" as="geometry"/></mxCell><mxCell id="pl39" value="(c)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="614" width="40" height="22" as="geometry"/></mxCell><mxCell id="panel40" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cdd6;strokeWidth=1;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="468" height="392" as="geometry"/></mxCell><mxCell id="pt41" value="Classifier-free guidance as vectors, schematic" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="652" width="428" height="20" as="geometry"/></mxCell><mxCell id="eq42" value="\(\hat\epsilon_s=\hat\epsilon_\varnothing+s\,(\hat\epsilon_y-\hat\epsilon_\varnothing),\quad\hat\epsilon_y=\hat\epsilon_\phi(z_t;y,t)\)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="670" width="428" height="34" as="geometry"/></mxCell><mxCell id="l43" value="" style="html=1;rounded=0;strokeColor=#7a8399;strokeWidth=1;endArrow=none;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="154.0" y="780" as="sourcePoint"/><mxPoint x="424.0" y="876" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l44" value="" style="html=1;rounded=0;strokeColor=#4f5d75;strokeWidth=1.8;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="84.0" y="930" as="sourcePoint"/><mxP