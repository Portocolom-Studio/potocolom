x="1" parent="1"><mxGeometry x="888" y="800" width="96" height="20" as="geometry"/></mxCell><mxCell id="cap82" value="aliases" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#7a8399;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="888" y="820" width="96" height="20" as="geometry"/></mxCell><mxCell id="c83" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;imageBorder=#c9cdd6;" vertex="1" parent="1"><mxGeometry x="40" y="908" width="120" height="102" as="geometry"/></mxCell><mxCell id="c84" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;imageBorder=#c9cdd6;" vertex="1" parent="1"><mxGeometry x="176" y="908" width="120" height="102" as="geometry"/></mxCell><mxCell id="cap85" value="2x crops of \(p\): smooth, printable" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1016" width="256" height="20" as="geometry"/></mxCell><mxCell id="vc86" value="&lt;b&gt;pixels hide the art in noise; weights hold the shape&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;\(B\) is drawn once and frozen, so the waves above are the whole fixed part&lt;br&gt;of \(g_\theta\). The output stays smooth enough to print (Diffusion Illusions, Sec. 4.3).&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=17;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="328" y="908" width="672" height="102" as="geometry"/></mxCell><mxCell id="eq87" value="\(p=g_\theta(v)=\mathrm{sigmoid}\big(\mathrm{conv}_\theta(\gamma(v))\big),\qquad\gamma(v)=[\cos(2\pi Bv),\ \sin(2\pi Bv)]\)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=17;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1046" width="960" height="38" as="geometry"/></mxCell><mxCell id="eqc88" value="Fourier features: Tancik et al. 2020" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1082" width="912" height="16" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>