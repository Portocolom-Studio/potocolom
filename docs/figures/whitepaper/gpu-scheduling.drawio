<mxfile host="potocolom" type="device"><diagram name="figure" id="fig"><mxGraphModel dx="1040" dy="922" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="1" shadow="0" background="#f5f5f5"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg1" value="" style="rounded=0;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=none;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=10;locked=1;movable=0;resizable=0;selectable=0;editable=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1040" height="902" as="geometry"/></mxCell><mxCell id="title2" value="One GPU, two kinds of work" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=24;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="960" height="32" as="geometry"/></mxCell><mxCell id="sw3" value="" style="rounded=0;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbeed6;strokeColor=#c9cdd6;strokeWidth=1;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="841.2" y="40" width="14" height="14" as="geometry"/></mxCell><mxCell id="lg4" value="paused and requeued" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="863.2" y="37" width="136.8" height="20" as="geometry"/></mxCell><mxCell id="sw5" value="" style="rounded=0;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cdd6;strokeWidth=1;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="725.2" y="40" width="14" height="14" as="geometry"/></mxCell><mxCell id="lg6" value="queued job" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="747.2" y="37" width="72.0" height="20" as="geometry"/></mxCell><mxCell id="sw7" value="" style="rounded=0;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6effc;strokeColor=#005ee3;strokeWidth=1;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="566.0" y="40" width="14" height="14" as="geometry"/></mxCell><mxCell id="lg8" value="realtime session" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="588.0" y="37" width="115.19999999999999" height="20" as="geometry"/></mxCell><mxCell id="panel9" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cdd6;strokeWidth=1;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="84" width="600" height="496" as="geometry"/></mxCell><mxCell id="icon10" value="" style="shape=mxgraph.aws4.instance2;fillColor=#2d3142;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="322.0" y="98" width="36" height="36" as="geometry"/></mxCell><mxCell id="pt11" value="One GPU worker" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="138" width="568" height="20" as="geometry"/></mxCell><mxCell id="ps12" value="capacity measured at warmup, not guessed" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#7a8399;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="160" width="568" height="20" as="geometry"/></mxCell><mxCell id="panel13" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cdd6;strokeWidth=1;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="672" y="84" width="328" height="496" as="geometry"/></mxCell><mxCell id="icon14" value="" style="shape=mxgraph.aws4.gear;fillColor=#2d3142;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="818.0" y="98" width="36" height="36" as="geometry"/></mxCell><mxCell id="pt15" value="The scheduler" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="688" y="138" width="296" height="20" as="geometry"/></mxCell><mxCell id="ps16" value="one leader-elected loop, in priority order" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#7a8399;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="688" y="160" width="296" height="20" as="geometry"/></mxCell><mxCell id="lb17" value="VRAM" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="64" y="188" width="300" height="18" as="geometry"/></mxCell><mxCell id="hot18" value="&lt;b&gt;hot set, pinned&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;fast models for drawing,&lt;br&gt;fully resident&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6effc;strokeColor=#005ee3;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="64" y="212" width="236" height="84" as="geometry"/></mxCell><mxCell id="dem19" value="&lt;b&gt;on demand&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;loaded on a miss,&lt;br&gt;coldest evicted first&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="308" y="212" width="180" height="84" as="geometry"/></mxCell><mxCell id="free20" value="&lt;b&gt;free&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;measured live&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#c9cdd6;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="496" y="212" width="120" height="84" as="geometry"/></mxCell><mxCell id="vn21" value="Only a fully resident model may draw: the realtime bar needs it." style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#7a8399;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="64" y="302" width="552" height="20" as="geometry"/></mxCell><mxCell id="lb22" value="REALTIME SLOTS, THEN IDLE CAPACITY" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="64" y="340" width="300" height="18" as="geometry"/></mxCell><mxCell id="s123" value="&lt;b&gt;session&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;slot 1&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6effc;strokeColor=#005ee3;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="64" y="364" width="116" height="64" as="geometry"/></mxCell><mxCell id="s224" value="&lt;b&gt;session&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;slot 2&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6effc;strokeColor=#005ee3;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="188" y="364" width="116" height="64" as="geometry"/></mxCell><mxCell id="sf25" value="&lt;b&gt;free slot&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;next session&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;dashed=1;dashPattern=6 4;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="312" y="364" width="116" height="64" as="geometry"/></mxCell><mxCell id="job26" value="&lt;b&gt;queued job&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;fills idle capacity&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="448" y="364" width="168" height="64" as="geometry"/></mxCell><mxCell id="mk27" value="3" style="ellipse;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2d3142;strokeColor=none;strokeWidth=1.2;fontFamily=Lato;fontSize=13;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="416" y="352" width="24" height="24" as="geometry"/></mxCell><mxCell id="mk28" value="4" style="ellipse;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2d3142;strokeColor=none;strokeWidth=1.2;fontFamily=Lato;fontSize=13;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="604" y="352" width="24" height="24" as="geometry"/></mxCell><mxCell id="cal29" value="Warmup benchmarks ms per frame at batch sizes 1 to N; the worker advertises the most sessions that keep p95 frame time under the 2 to 4 fps bar." style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="64" y="436" width="360" height="60" as="geometry"/></mxCell><mxCell id="pz30" value="&lt;b&gt;paused&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;between denoising steps,&lt;br&gt;requeued&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fbeed6;strokeColor=#b26b00;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="448" y="492" width="168" height="64" as="geometry"/></mxCell><mxCell id="e31" value="a session needs it" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b26b00;strokeWidth=1.4;fontFamily=Lato;fontSize=12;fontColor=#7a8399;labelBackgroundColor=#f5f5f5;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="job26" target="pz30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lock32" value="One GPU lock: resident models take turns, so co-residency saves switching time, not compute." style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#7a8399;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="64" y="508" width="360" height="48" as="geometry"/></mxCell><mxCell id="st33" value="&lt;b&gt;Reconcile&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;an expired heartbeat requeues&lt;br&gt;its jobs; sessions reassign&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=left;spacingLeft=16;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="704" y="188" width="280" height="88" as="geometry"/></mxCell><mxCell id="mk34" value="1" style="ellipse;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2d3142;strokeColor=none;strokeWidth=1.2;fontFamily=Lato;fontSize=13;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="676" y="220" width="24" height="24" as="geometry"/></mxCell><mxCell id="st35" value="&lt;b&gt;Idle release&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;60 s without input frees&lt;br&gt;the slot, metering stops&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=left;spacingLeft=56;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="704" y="284" width="280" height="88" as="geometry"/></mxCell><mxCell id="icon36" value="" style="shape=mxgraph.aws4.backup_recovery_time_objective;fillColor=#2d3142;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="718" y="312" width="32" height="32" as="geometry"/></mxCell><mxCell id="mk37" value="2" style="ellipse;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2d3142;strokeColor=none;strokeWidth=1.2;fontFamily=Lato;fontSize=13;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="676" y="316" width="24" height="24" as="geometry"/></mxCell><mxCell id="st38" value="&lt;b&gt;Admit&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;free slots go to sessions first;&lt;br&gt;a job is paused if needed&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6effc;strokeColor=#005ee3;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=left;spacingLeft=56;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="704" y="380" width="280" height="88" as="geometry"/></mxCell><mxCell id="icon39" value="" style="shape=mxgraph.aws4.multimedia;fillColor=#005ee3;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="718" y="408" width="32" height="32" as="geometry"/></mxCell><mxCell id="mk40" value="3" style="ellipse;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2d3142;strokeColor=none;strokeWidth=1.2;fontFamily=Lato;fontSize=13;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="676" y="412" width="24" height="24" as="geometry"/></mxCell><mxCell id="st41" value="&lt;b&gt;Fill&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;idle capacity takes&lt;br&gt;queued jobs&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=left;spacingLeft=56;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="704" y="476" width="280" height="88" as="geometry"/></mxCell><mxCell id="icon42" value="" style="shape=mxgraph.aws4.queue;fillColor=#2d3142;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="718" y="504" width="32" height="32" as="geometry"/></mxCell><mxCell id="mk43" value="4" style="ellipse;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2d3142;strokeColor=none;strokeWidth=1.2;fontFamily=Lato;fontSize=13;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="676" y="508" width="24" height="24" as="geometry"/></mxCell><mxCell id="of44" value="When every slot is taken" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="628" width="960" height="20" as="geometry"/></mxCell><mxCell id="q45" value="&lt;b&gt;admission queue&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;sessions wait with a&lt;br&gt;live position&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=left;spacingLeft=60;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="260" height="96" as="geometry"/></mxCell><mxCell id="icon46" value="" style="shape=mxgraph.aws4.queue;fillColor=#2d3142;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="54" y="688" width="40" height="40" as="geometry"/></mxCell><mxCell id="au47" value="&lt;b&gt;fleet autoscaler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;reads queue depth&lt;br&gt;and free slots&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=left;spacingLeft=60;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="420" y="660" width="240" height="96" as="geometry"/></mxCell><mxCell id="icon48" value="" style="shape=mxgraph.aws4.gear;fillColor=#2d3142;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="434" y="688" width="40" height="40" as="geometry"/></mxCell><mxCell id="gp49" value="&lt;b&gt;another GPU&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;rented, then calibrated&lt;br&gt;at warmup&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6effc;strokeColor=#005ee3;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=left;spacingLeft=60;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="780" y="660" width="220" height="96" as="geometry"/></mxCell><mxCell id="icon50" value="" style="shape=mxgraph.aws4.instance2;fillColor=#005ee3;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="794" y="688" width="40" height="40" as="geometry"/></mxCell><mxCell id="e51" value="queue depth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=12;fontColor=#7a8399;labelBackgroundColor=#f5f5f5;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q45" target="au47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e52" value="rents a machine" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#005ee3;strokeWidth=1.8;fontFamily=Lato;fontSize=12;fontColor=#7a8399;labelBackgroundColor=#f5f5f5;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="au47" target="gp49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rule53" value="&lt;b&gt;the rule&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;Realtime sessions come first and are never oversubscribed. Queued jobs fill idle capacity and pause&lt;br&gt;between denoising steps when a session needs the slot. Nothing ever preempts an active session.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#c9cdd6;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="784" width="960" height="86" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>