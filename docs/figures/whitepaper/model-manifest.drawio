12px&quot;&gt;&amp;quot;source&amp;quot;: &amp;quot;segmind/Segmind-Vega&amp;quot;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:12px&quot;&gt;&amp;quot;scheduler&amp;quot;: &amp;quot;lcm&amp;quot;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:12px&quot;&gt;&amp;quot;lora&amp;quot;: &amp;quot;segmind/Segmind-VegaRT/...&amp;quot;&lt;/span&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#c9cdd6;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=left;spacingLeft=14;spacingRight=2;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="400" height="96" as="geometry"/></mxCell><mxCell id="b13" value="&lt;b&gt;identity and routing&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;&lt;span style=&quot;font-family:Courier New;font-size:12px&quot;&gt;&amp;quot;id&amp;quot;: &amp;quot;vega-rt&amp;quot;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:12px&quot;&gt;&amp;quot;capabilities&amp;quot;: [&amp;quot;realtime&amp;quot;, ...]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:12px&quot;&gt;&amp;quot;min_vram_gb&amp;quot;: 8&lt;/span&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=left;spacingLeft=14;spacingRight=2;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="252" width="400" height="96" as="geometry"/></mxCell><mxCell id="b14" value="&lt;b&gt;parameters, a JSON Schema&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;&lt;span style=&quot;font-family:Courier New;font-size:12px&quot;&gt;&amp;quot;steps&amp;quot;: {&amp;quot;minimum&amp;quot;: 2, &amp;quot;maximum&amp;quot;: 8}&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:12px&quot;&gt;&amp;quot;guidance&amp;quot;: {&amp;quot;minimum&amp;quot;: 0, &amp;quot;maximum&amp;quot;: 2}&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:12px&quot;&gt;&amp;quot;width&amp;quot;: {&amp;quot;enum&amp;quot;: [512, 1024], &amp;quot;default&amp;quot;: 512}&lt;/span&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6effc;strokeColor=#005ee3;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=left;spacingLeft=14;spacingRight=2;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="364" width="400" height="118" as="geometry"/></mxCell><mxCell id="b15" value="&lt;b&gt;license&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;&lt;span style=&quot;font-family:Courier New;font-size:12px&quot;&gt;&amp;quot;license_id&amp;quot;: &amp;quot;apache-2.0&amp;quot;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Courier New;font-size:12px&quot;&gt;&amp;quot;license_url&amp;quot;: &amp;quot;...&amp;quot;&lt;/span&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=left;spacingLeft=14;spacingRight=2;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="498" width="400" height="78" as="geometry"/></mxCell><mxCell id="r16" value="&lt;b&gt;GPU worker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;builds the pipeline from the recipe;&lt;br&gt;min_vram_gb feeds its memory ladder&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=left;spacingLeft=68;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="140" width="400" height="104" as="geometry"/></mxCell><mxCell id="icon17" value="" style="shape=mxgraph.aws4.instance2;fillColor=#2d3142;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="618" y="172" width="40" height="40" as="geometry"/></mxCell><mxCell id="r18" value="&lt;b&gt;Platform API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;receives the manifest without the recipe,&lt;br&gt;routes by model and capability, and checks&lt;br&gt;every request against the schema&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=left;spacingLeft=68;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="280" width="400" height="116" as="geometry"/></mxCell><mxCell id="icon19" value="" style="shape=mxgraph.aws4.traditional_server;fillColor=#2d3142;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="618" y="318" width="40" height="40" as="geometry"/></mxCell><mxCell id="r20" value="&lt;b&gt;Studio&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;sizes its fixed controls (steps, guidance,&lt;br&gt;strength, width) from minimum, maximum,&lt;br&gt;default and enum in the schema&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=left;spacingLeft=68;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="432" width="400" height="116" as="geometry"/></mxCell><mxCell id="icon21" value="" style="sh