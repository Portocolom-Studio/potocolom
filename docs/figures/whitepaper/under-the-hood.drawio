eight="46" as="geometry"/></mxCell><mxCell id="td54" value="the worker dials out and announces a manifest: capabilities, parameter schema, VRAM needs" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266" y="724" width="388" height="46" as="geometry"/></mxCell><mxCell id="td55" value="one persistent WebSocket; no inbound ports, no public address" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="666" y="724" width="328" height="46" as="geometry"/></mxCell><mxCell id="td56" value="3" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="46" y="770" width="28" height="46" as="geometry"/></mxCell><mxCell id="td57" value="API and worker" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#2d3142;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="86" y="770" width="168" height="46" as="geometry"/></mxCell><mxCell id="td58" value="sessions, jobs and frames out; live progress and generated frames back" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266" y="770" width="388" height="46" as="geometry"/></mxCell><mxCell id="td59" value="each request is checked against the manifest schema first" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="666" y="770" width="328" height="46" as="geometry"/></mxCell><mxCell id="td60" value="4" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#