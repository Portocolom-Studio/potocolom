<mxCell id="lg6" value="scheduler step" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="689.6" y="37" width="100.8" height="20" as="geometry"/></mxCell><mxCell id="sw7" value="" style="rounded=0;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6effc;strokeColor=#005ee3;strokeWidth=1;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="530.0" y="40" width="14" height="14" as="geometry"/></mxCell><mxCell id="lg8" value="realtime path" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="552.0" y="37" width="93.60000000000001" height="20" as="geometry"/></mxCell><mxCell id="sw9" value="" style="rounded=0;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e4e7ec;strokeColor=#8e98ac;strokeWidth=1;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="435.6" y="40" width="14" height="14" as="geometry"/></mxCell><mxCell id="lg10" value="browser" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="457.6" y="37" width="50.400000000000006" height="20" as="geometry"/></mxCell><mxCell id="lane11" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cdd6;strokeWidth=1;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="210" height="390" as="geometry"/></mxCell><mxCell id="lt12" value="Browser" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="112" width="178" height="20" as="geometry"/></mxCell><mxCell id="icon13" value="" style="shape=mxgraph.aws4.client;fillColor=#2d3142;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="54" y="110" width="26" height="26" as="geometry"/></mxCell><mxCell id="lane14" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cdd6;strokeWidth=1;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="266" y="100" width="444" height="390" as="geometry"/></mxCell><mxCell id="lt15" value="API and scheduler" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="282" y="112" width="412" height="20" as="geometry"/></mxCell><mxCell id="icon16" value="" style="shape=mxgraph.aws4.traditional_server;fillColor=#2d3142;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="26" height="26" as="geometry"/></mxCell><mxCell id="lane17" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cdd6;strokeWidth=1;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="726" y="100" width="274" height="390" as="geometry"/></mxCell><mxCell id="lt18" value="GPU worker pool" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="742" y="112" width="242" height="20" as="geometry"/></mxCell><mxCell id="icon19" value="" style="shape=mxgraph.aws4.instance2;fillColor=#2d3142;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="740" y="110" width="26" height="26" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;open a session&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;one WebSocket&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e4e7ec;strokeColor=#8e98ac;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;spacingLeft=50;" vertex="1" parent="1"><mxGeometry x="58" y="156" width="174" height="72" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;auth, then check the schema&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;designed: reserve the first 60 GPU-second chunk&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;spacingLeft=50;" vertex="1" parent="1"><mxGeometry x="290" y="156" width="396" height="72" as="geometry"/></mxCell><mxCell id="q22" value="free realtime slot?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;" vertex="1" parent="1"><mxGeometry x="398" y="260" width="180" height="80" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;admission queue&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;today a full platform refuses the session;&lt;br&gt;designed: a queue with a live position&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#c9cdd6;dashed=1;dashPattern=6 4;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;spacingLeft=50;" vertex="1" parent="1"><mxGeometry x="290" y="372" width="396" height="80" as="geometry"/></mxCell><mxCell id="t24" value="designed: queue depth is the signal to boot more GPUs" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#7a8399;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="290" y="460" width="396" height="20" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;slot acquired&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;model fully resident,&lt;br&gt;warmed, ready within 10 s&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6effc;strokeColor=#005ee3;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;spacingLeft=50;" vertex="1" parent="1"><mxGeometry x="746" y="250" width="234" height="100" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;queued image jobs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;share the worker today;&lt;br&gt;designed: paused between steps&lt;br&gt;when a session needs the slot&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;dashed=1;dashPattern=6 4;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="746" y="372" width="234" height="96" as="geometry"/></mxCell><mxCell id="t27" value="slot frees, or a new GPU boots" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=0;align=right;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="520" y="346" width="190" height="18" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;the canvas stays here&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;if the worker is lost, the&lt;br&gt;drawing is never lost:&lt;br&gt;it is re-sent to the new one&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#c9cdd6;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="58" y="372" width="174" height="96" as="geometry"/></mxCell><mxCell id="icon29" value="" style="shape=mxgraph.aws4.internet_alt2;fillColor=#2d3142;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="66" y="174" width="36" height="36" as="geometry"/></mxCell><mxCell id="icon30" value="" style="shape=mxgraph.aws4.savings_plans;fillColor=#2d3142;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="302" y="174" width="36" height="36" as="geometry"/></mxCell><mxCell id="icon31" value="" style="shape=mxgraph.aws4.gear;fillColor=#2d3142;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="340" y="282" width="36" height="36" as="geometry"/></mxCell><mxCell id="icon32" value="" style="shape=mxgraph.aws4.queue;fillColor=#2d3142;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="302" y="394" width="36" height="36" as="geometry"/></mxCell><mxCell id="icon33" value="" style="shape=mxgraph.aws4.instance2;fillColor=#005ee3;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="756" y="282" width="36" height="36" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#f5f5f5;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#f5f5f5;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="c21" target="q22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e36" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q22" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e37" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#f5f5f5;endArrow=block;endFill=1;endSize=7;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="716" y="412"/><mxPoint x="716" y="356"/><mxPoint x="863" y="356"/></Array></mxGeometry></mxCell><mxCell id="c39" value="&lt;b&gt;the loop - 2 to 4 generated frames per second at 512 px&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;canvas frames up, generated frames down: binary WebP on one WebSocket (a Redis relay between API replicas is designed)&lt;br&gt;latest input wins: a new stroke replaces the pending frame, and superseded frames are dropped&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6effc;strokeColor=#005ee3;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;spacingLeft=54;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="960" height="96" as="geometry"/></mxCell><mxCell id="icon40" value="" style="shape=mxgraph.aws4.multimedia;fillColor=#005ee3;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="548" width="40" height="40" as="geometry"/></mxCell><mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#f5f5f5;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.9896;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c25" target="c39"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="300"/></Array></mxGeometry></mxCell><mxCell id="s42" value="&lt;b&gt;Queued&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;waiting for a slot&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;dashed=1;dashPattern=6 4;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;spacingLeft=50;" vertex="1" parent="1"><mxGeometry x="40" y="741" width="190" height="64" as="geometry"/></mxCell><mxCell id="s43" value="&lt;b&gt;Active&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;drawing&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6effc;strokeColor=#005ee3;strokeWidth=1.2;fontFamily=L