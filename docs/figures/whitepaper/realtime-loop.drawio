le="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6effc;strokeColor=#005ee3;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;spacingLeft=50;" vertex="1" parent="1"><mxGeometry x="746" y="250" width="234" height="100" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;queued image jobs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;fill idle slots, paused between&lt;br&gt;denoising steps and requeued&lt;br&gt;when a session needs one&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="746" y="372" width="234" height="96" as="geometry"/></mxCell><mxCell id="t25" value="slot frees, or a new GPU boots" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=0;align=right;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="520" y="346" width="190" height="18" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;the canvas stays here&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;idle or reassigned, the&lt;br&gt;drawing is never lost:&lt;br&gt;it is re-sent on reconnect&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#c9cdd6;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="58" y="372" width="174" height="96" as="geometry"/></mxCell><mxCell id="icon27" value="" style="shape=mxgraph.aws4.internet_alt2;fillColor=#2d3142;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x=