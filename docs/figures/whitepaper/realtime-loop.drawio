metry></mxCell><mxCell id="e35" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#f5f5f5;endArrow=block;endFill=1;endSize=7;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="716" y="412"/><mxPoint x="716" y="356"/><mxPoint x="863" y="356"/></Array></mxGeometry></mxCell><mxCell id="c37" value="&lt;b&gt;the loop - 2 to 4 generated frames per second at 512 px&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;canvas frames up, generated frames down: binary WebP on one WebSocket, relayed between replicas over Redis pub/sub&lt;br&gt;latest input wins: a new stroke replaces the pending frame, and superseded frames are dropped&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6effc;strokeColor=#005ee3;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;spacingLeft=54;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="960" height="96" as="geometry"/></mxCell><mxCell id="icon38" value="" style="shape=mxgraph.aws4.multimedia;fillColor=#005ee3;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="548" width="40" height="40" as="geometry"/></mxCell><mxCell id="e39" value="" style="edgeS