middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="510" y="444" width="238" height="76" as="geometry"/></mxCell><mxCell id="td40" value="Recovery is just the invoice.paid webhook re-entering the same idempotent path" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="768" y="444" width="226" height="76" as="geometry"/></mxCell><mxCell id="tag41" value="designed" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#2d3142;strokeWidth=1;fontFamily=Lato;fontSize=11;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="76" y="496" width="74" height="18" as="geometry"/></mxCell><mxCell id="icon42" value="" style="shape=mxgraph.aws4.ssl_padlock;fillColor=#b4232a;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="46" y="547" width="22" height="22" as="geometry"/></mxCell><mxCell id="td43" value="Billing service unreachable" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="76" y="520" width="170" height="52" as="geometry"/></mxCell><mxCell id="td44" value="Billing temporarily unavailable on new work; running and finished work unaffected" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266" y="520" width="224" height="76" as="geometry"/></mxCell><mxCell id="td45" value="Reserve fails closed - zero GPU time granted on credit; commit and refund retry through an outbox" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="510" y="520" width="238" height="76" as="geometry"/></mxCell><mxCell id="td46" value="At-least-once delivery plus unique ledger keys: settlement lands exactly once" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="768" y="520" width="226" height="76" as="geometry"/></mxCell><mxCell id="tag47" value="designed" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#2d3142;strokeWidth=1;fontFamily=Lato;fontSize=11;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="76" y="572" width="74" height="18" as="geometry"/></mxCell><mxCell id="l48" value="" style="html=1;rounded=0;strokeColor=#c9cdd6;strokeWidth=0.8;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40.0" y="600" as="sourcePoint"/><mxPoint x="1000.0" y="600" as="targetPoint"/></mxGeometry></mxCell><mxCell id="icon49" value="" style="shape=mxgraph.aws4.traditional_server;fillColor=#005ee3;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="46" y="606" width="20" height="20" as="geometry"/></mxCell><mxCell id="grp50" value="infrastructure" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#005ee3;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="74" y="606" width="400" height="24" as="geometry"/></mxCell><mxCell id="icon51" value="" style="shape=mxgraph.aws4.users;fillColor=#b4232a;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="46" y="659" width="22" height="22" as="geometry"/></mxCell><mxCell id="td52" value="Demand spike or autoscaler fault" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="76" y="632" width="170" height="52" as="geometry"/></mxCell><mxCell id="td53" value="A waiting room with live position behind a high-demand banner" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266" y="632" width="224" height="76" as="geometry"/></mxCell><mxCell id="td54" value="A hard machine ceiling and a monthly budget: scaling simply stops" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="510" y="632" width="238" height="76" as="geometry"/></mxCell><mxCell id="td55" value="No failure mode produces an unbounded bill; raising the cap is a deliberate config change" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="768" y="632" width="226" height="76" as="geometry"/></mxCell><mxCell id="tag56" value="designed" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#2d3142;strokeWidth=1;fontFamily=Lato;fontSize=11;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="76" y="684" width="74" height="18" as="geometry"/></mxCell><mxCell id="icon57" value="" style="shape=mxgraph.aws4.traditional_server;fillColor=#b4232a;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="46" y="735" width="22" height="22" as="geometry"/></mxCell><mxCell id="td58" value="Availability zone failure" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="76" y="708" width="170" height="52" as="geometry"/></mxCell><mxCell id="td59" value="Up to about an hour of downtime" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266" y="708" width="224" height="76" as="geometry"/></mxCell><mxCell id="td60" value="Up to five minutes of writes lost; point-in-time-recovery restore" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="510" y="708" width="238" height="76" as="geometry"/></mxCell><mxCell id="td61" value="Redis is never a source of truth; multi-AZ is a checkbox once there is revenue to protect" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="768" y="708" width="226" height="76" as="geometry"/></mxCell><mxCell id="tag62" value="designed" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#2d3142;strokeWidth=1;fontFamily=Lato;fontSize=11;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=0;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="76" y="760" width="74" height="18" as="geometry"/></mxCell><mxCell id="l63" value="" style="html=1;rounded=0;strokeColor=#2d3142;strokeWidth=1.4;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40.0" y="788" as="sourcePoint"/><mxPoint x="1000.0" y="788" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rules64" value="&lt;b&gt;Three rules under every row&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;Retries are bounded, failures refund, and no failure mode produces a surprise bill.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#c9cdd6;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="960" height="84" as="geometry"/></mxCell><mxCell id="icon65" value="" style="shape=mxgraph.aws4.shield2;fillColor=#005ee3;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="68" y="830" width="44" height="44" as="geometry"/></mxCell><mxCell id="foot66" value="Every row is a recorded decision in docs/decisions.md, not an aspiration." style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=2;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="906" width="960" height="18" as="geometry"/></mxCell><mxCell id="foot267" value="The money column is the hosted billing design throughout: the open-source build has no quota client yet." style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=2;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="926" width="960" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>