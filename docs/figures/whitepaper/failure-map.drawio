Color=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="768" y="180" width="226" height="76" as="geometry"/></mxCell><mxCell id="tag20" value="shipped" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e3f1e8;strokeColor=#1f7a4d;strokeWidth=1;fontFamily=Lato;fontSize=11;fontColor=#1f7a4d;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="76" y="232" width="74" height="18" as="geometry"/></mxCell><mxCell id="icon21" value="" style="shape=mxgraph.aws4.backup_plan;fillColor=#b4232a;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="46" y="283" width="22" height="22" as="geometry"/></mxCell><mxCell id="td22" value="The same job fails twice" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="76" y="256" width="170" height="52" as="geometry"/></mxCell><mxCell id="td23" value="A failed job with a retry button" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266" y="256" width="224" height="76" as="geometry"/></mxCell><mxCell id="td24" value="Credits auto-refunded, idempotent on the reservation id" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="510" y="256" width="238" height="76" as="geometry"/></mxCell><mxCell id="td25" value="No third attempt: an input that crashes workers cannot burn GPU money in a loop" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="768" y="256" width="226" height="76" as="geometry"/></mxCell><mxCell id="tag26" value="shipped" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e3f1e8;strokeColor=#1f7a4d;strokeWidth=1;fontFamily=Lato;fontSize=11;fontColor=#1f7a4d;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="76" y="308" width="74" height="18" as="geometry"/></mxCell><mxCell id="icon27" value="" style="shape=mxgraph.aws4.multimedia;fillColor=#b4232a;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="46" y="359" width="22" height="22" as="geometry"/></mxCell><mxCell id="td28" value="Worker dies mid drawing session" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="76" y="332" width="170" height="52" as="geometry"/></mxCell><mxCell id="td29" value="Interrupted, then resumed; the canvas is re-sent automatically" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266" y="332" width="224" height="76" as="geometry"/></mxCell><mxCell id="td30" value="The partial chunk is committed; a fresh chunk opens on the new worker" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="510" y="332" width="238" height="76" as="geometry"/></mxCell><mxCell id="td31" value="Overdraft is bounded by one 60 GPU-second chunk" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="768" y="332" width="226" height="76" as="geometry"/></mxCell><mxCell id="tag32" value="shipped" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e3f1e8;strokeColor=#1f7a4d;strokeWidth=1;fontFamily=Lato;fontSize=11;font