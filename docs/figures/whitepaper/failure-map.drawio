<mxfile host="potocolom" type="device"><diagram name="figure" id="fig"><mxGraphModel dx="1040" dy="878" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="1" shadow="0" background="#f5f5f5"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg1" value="" style="rounded=0;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=none;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=1;align=center;verticalAlign=middle;spacing=10;locked=1;movable=0;resizable=0;selectable=0;editable=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1040" height="858" as="geometry"/></mxCell><mxCell id="title2" value="What breaks, what the user sees, what the money does" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=24;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="960" height="32" as="geometry"/></mxCell><mxCell id="l3" value="" style="html=1;rounded=0;strokeColor=#2d3142;strokeWidth=1.4;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40.0" y="84" as="sourcePoint"/><mxPoint x="1000.0" y="84" as="targetPoint"/></mxGeometry></mxCell><mxCell id="th4" value="&lt;span style=&quot;letter-spacing:1px&quot;&gt;FAILURE&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=11;fontColor=#7a8399;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="46" y="92" width="200" height="18" as="geometry"/></mxCell><mxCell id="th5" value="&lt;span style=&quot;letter-spacing:1px&quot;&gt;WHAT THE USER SEES&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=11;fontColor=#7a8399;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266" y="92" width="224" height="18" as="geometry"/></mxCell><mxCell id="th6" value="&lt;span style=&quot;letter-spacing:1px&quot;&gt;WHAT THE MONEY DOES&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=11;fontColor=#7a8399;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="510" y="92" width="238" height="18" as="geometry"/></mxCell><mxCell id="th7" value="&lt;span style=&quot;letter-spacing:1px&quot;&gt;WHY IT CANNOT SPIRAL&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=11;fontColor=#7a8399;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="768" y="92" width="226" height="18" as="geometry"/></mxCell><mxCell id="l8" value="" style="html=1;rounded=0;strokeColor=#2d3142;strokeWidth=0.8;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40.0" y="116" as="sourcePoint"/><mxPoint x="1000.0" y="116" as="targetPoint"/></mxGeometry></mxCell><mxCell id="grp9" value="compute" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#005ee3;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="46" y="126" width="400" height="24" as="geometry"/></mxCell><mxCell id="d10" value="" style="ellipse;html=1;fillColor=#b4232a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="181" width="8" height="8" as="geometry"/></mxCell><mxCell id="td11" value="Worker dies mid job (spot reclaim)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="46" y="152" width="200" height="66" as="geometry"/></mxCell><mxCell id="td12" value="A longer wait, then the result" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266" y="152" width="224" height="66" as="geometry"/></mxCell><mxCell id="td13" value="Reservation rides along unchanged; commit happens when the retry completes" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="510" y="152" width="238" height="66" as="geometry"/></mxCell><mxCell id="td14" value="Exactly one automatic retry, requeued on another worker" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="768" y="152" width="226" height="66" as="geometry"/></mxCell><mxCell id="d15" value="" style="ellipse;html=1;fillColor=#b4232a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="247" width="8" height="8" as="geometry"/></mxCell><mxCell id="td16" value="The same job fails twice" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="46" y="218" width="200" height="66" as="geometry"/></mxCell><mxCell id="td17" value="A failed job with a retry button" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266" y="218" width="224" height="66" as="geometry"/></mxCell><mxCell id="td18" value="Credits auto-refunded, idempotent on the reservation id" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="510" y="218" width="238" height="66" as="geometry"/></mxCell><mxCell id="td19" value="No third attempt: an input that crashes workers cannot burn GPU money in a loop" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="768" y="218" width="226" height="66" as="geometry"/></mxCell><mxCell id="d20" value="" style="ellipse;html=1;fillColor=#b4232a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="313" width="8" height="8" as="geometry"/></mxCell><mxCell id="td21" value="Worker dies mid drawing session" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="46" y="284" width="200" height="66" as="geometry"/></mxCell><mxCell id="td22" value="Interrupted, then resumed; the canvas is re-sent automatically" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266" y="284" width="224" height="66" as="geometry"/></mxCell><mxCell id="td23" value="The partial chunk is committed; a fresh chunk opens on the new worker" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="510" y="284" width="238" height="66" as="geometry"/></mxCell><mxCell id="td24" value="Overdraft is bounded by one 60 GPU-second chunk" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="768" y="284" width="226" height="66" as="geometry"/></mxCell><mxCell id="l25" value="" style="html=1;rounded=0;strokeColor=#c9cdd6;strokeWidth=0.8;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40.0" y="354" as="sourcePoint"/><mxPoint x="1000.0" y="354" as="targetPoint"/></mxGeometry></mxCell><mxCell id="grp26" value="money" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#005ee3;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="46" y="360" width="400" height="24" as="geometry"/></mxCell><mxCell id="d27" value="" style="ellipse;html=1;fillColor=#b4232a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="415" width="8" height="8" as="geometry"/></mxCell><mxCell id="td28" value="Subscription renewal fails" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="46" y="386" width="200" height="66" as="geometry"/></mxCell><mxCell id="td29" value="Stripe&amp;#x27;s dunning emails; drawing continues on the remaining balance" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266" y="386" width="224" height="66" as="geometry"/></mxCell><mxCell id="td30" value="No new grant, nothing clawed back; the balance expires at period end, then free tier" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="510" y="386" width="238" height="66" as="geometry"/></mxCell><mxCell id="td31" value="Recovery is just the invoice.paid webhook re-entering the same idempotent path" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="768" y="386" width="226" height="66" as="geometry"/></mxCell><mxCell id="d32" value="" style="ellipse;html=1;fillColor=#b4232a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="481" width="8" height="8" as="geometry"/></mxCell><mxCell id="td33" value="Billing service unreachable" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="46" y="452" width="200" height="66" as="geometry"/></mxCell><mxCell id="td34" value="Billing temporarily unavailable on new work; running and finished work unaffected" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266" y="452" width="224" height="66" as="geometry"/></mxCell><mxCell id="td35" value="Reserve fails closed - zero GPU time granted on credit; commit and refund retry through an outbox" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="510" y="452" width="238" height="66" as="geometry"/></mxCell><mxCell id="td36" value="At-least-once delivery plus unique ledger keys: settlement lands exactly once" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="768" y="452" width="226" height="66" as="geometry"/></mxCell><mxCell id="l37" value="" style="html=1;rounded=0;strokeColor=#c9cdd6;strokeWidth=0.8;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40.0" y="522" as="sourcePoint"/><mxPoint x="1000.0" y="522" as="targetPoint"/></mxGeometry></mxCell><mxCell id="grp38" value="infrastructure" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#005ee3;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="46" y="528" width="400" height="24" as="geometry"/></mxCell><mxCell id="d39" value="" style="ellipse;html=1;fillColor=#b4232a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="583" width="8" height="8" as="geometry"/></mxCell><mxCell id="td40" value="Demand spike or autoscaler fault" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="46" y="554" width="200" height="66" as="geometry"/></mxCell><mxCell id="td41" value="A waiting room with live position behind a high-demand banner" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266" y="554" width="224" height="66" as="geometry"/></mxCell><mxCell id="td42" value="A hard machine ceiling and a monthly budget: scaling simply stops" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="510" y="554" width="238" height="66" as="geometry"/></mxCell><mxCell id="td43" value="No failure mode produces an unbounded bill; raising the cap is a deliberate config change" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="768" y="554" width="226" height="66" as="geometry"/></mxCell><mxCell id="d44" value="" style="ellipse;html=1;fillColor=#b4232a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="649" width="8" height="8" as="geometry"/></mxCell><mxCell id="td45" value="Availability zone failure" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="46" y="620" width="200" height="66" as="geometry"/></mxCell><mxCell id="td46" value="Up to about an hour of downtime" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266" y="620" width="224" height="66" as="geometry"/></mxCell><mxCell id="td47" value="Up to five minutes of writes lost; point-in-time-recovery restore" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="510" y="620" width="238" height="66" as="geometry"/></mxCell><mxCell id="td48" value="Redis is never a source of truth; multi-AZ is a checkbox once there is revenue to protect" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="768" y="620" width="226" height="66" as="geometry"/></mxCell><mxCell id="l49" value="" style="html=1;rounded=0;strokeColor=#2d3142;strokeWidth=1.4;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40.0" y="690" as="sourcePoint"/><mxPoint x="1000.0" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="rules50" value="&lt;b&gt;Three rules under every row&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;Retries are bounded, failures refund, and no failure mode produces a surprise bill.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#c9cdd6;strokeWidth=1.2;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="712" width="960" height="84" as="geometry"/></mxCell><mxCell id="foot51" value="Every row is a recorded decision in docs/decisions.md, not an aspiration." style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=2;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="808" width="960" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>