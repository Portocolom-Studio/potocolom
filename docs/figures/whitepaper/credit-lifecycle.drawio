 id="e60" value="refund" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b26b00;strokeWidth=1.4;fontFamily=Lato;fontSize=12;fontColor=#7a8399;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c52" target="st54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e61" value="TTL sweep" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b4232a;strokeWidth=1.4;fontFamily=Lato;fontSize=12;fontColor=#7a8399;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.8571428571428571;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c52" target="st55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="codes62" value="answers 201 created, 200 already exists, 402 insufficient credits, 409 wrong state" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="276" y="1032" width="500" height="24" as="geometry"/></mxCell><mxCell id="oneway63" value="one-way transitions: a repeat is a no-op, a conflict answers 409. The sweeper expires reservations stranded by a crash and returns the credits." style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="276" y="1062" width="700" height="40" as="geometry"/></mxCell><mxCell id="c64" value="&lt;b&gt;usage shapes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;jobs: reserve the estimate, commit the actual gpu_ms;&lt;br&gt;failed jobs refund automatically&lt;br&gt;sessions: 60 GPU-second chunks, extended while drawing;&lt;br&gt;a failed extension closes the session gracefully,&lt;br&gt;at most one chunk of overdraft&lt;br&gt;insufficient credits answer 402 before any GPU spend&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#c9cdd6;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=left;spacingLeft=14;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="64" y="1124" width="440" height="176" as="geometry"/></mxCell><mxCell id="icon65" value="" style="shape=mxgraph.aws4.permissions;fillColor=#2d3142;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="450" y="1138" width="36" height="36" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b&gt;when billing is down&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;reserve fails closed: no GPU time is ever granted on credit&lt;br&gt;commit and refund queue in an outbox in the API&amp;#x27;s&lt;br&gt;PostgreSQL and retry until acknowledged&lt;br&gt;at-least-once delivery + unique ledger keys:&lt;br&gt;settlement lands exactly once&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=left;spacingLeft=14;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="528" y="1124" width="448" height="176" as="geometry"/></mxCell><mxCell id="icon67" value="" style="shape=mxgraph.aws4.ssl_padlock;fillColor=#2d3142;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="926" y="1138" width="36" height="36" as="geometry"/></mxCell><mxCell id="status68" value="&lt;b&gt;The hosted billing design, not built yet.&lt;/b&gt; The open-source build has no quota client: a self-hosted install has no credits and records GPU time for analytics only." style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=14;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="960" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>