keWidth=1.2;fontFamily=Courier New;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="64" y="560" width="440" height="128" as="geometry"/></mxCell><mxCell id="lx36" value="Grants are keyed by invoice id, the trial grant by user id, spends and refunds by reservation id, claw-backs by refund or dispute id. The balance column is a cache rebuilt from this table, so drift is repairable by construction. A negative balance only blocks new reservations." style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="528" y="560" width="448" height="128" as="geometry"/></mxCell><mxCell id="pl37" value="(c)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="728" width="40" height="22" as="geometry"/></mxCell><mxCell id="panel38" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9cdd6;strokeWidth=1;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="756" width="960" height="448" as="geometry"/></mxCell><mxCell id="pt39" value="Money out - GPU usage through the quota contract (/v1, public and versioned)" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=14;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="770" width="920" height="20" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;API generates&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;a reservation UUID&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="64" y="816" width="180" height="72" as="geometry"/></mxCell><mxCell id="put41" value="&lt;b&gt;&lt;span style=&quot;font-family:Courier New&quot;&gt;PUT /v1/reservations/{id}&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#4f5d75&quot;&gt;estimate + TTL, retry-safe on the same id&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="276" y="816" width="252" height="72" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;reserved&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e4e7ec;strokeColor=#8e98ac;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="560" y="816" width="132" height="72" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;committed&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="796" y="792" width="180" height="48" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;refunded&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#c9cdd6;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="796" y="856" width="180" height="48" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;expired (TTL)&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#c9cdd6;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="796" y="920" width="180" height="48" as="geometry"/></mxCell><mxCell id="e46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="c40" target="put41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;" edge="1" parent="1" source="put41" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e48" value="commit actuals" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c42" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e49" value="refund" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c42" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e50" value="TTL sweep" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c42" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="codes51" value="answers 201 created, 200 already exists, 402 insufficient credits, 409 wrong state" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=12;fontColor=#7a8399;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="276" y="896" width="500" height="24" as="geometry"/></mxCell><mxCell id="oneway52" value="one-way transitions: a repeat is a no-op, a conflict answers 409. The sweeper expires reservations stranded by a crash and returns the credits." style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=13;fontColor=#4f5d75;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="276" y="936" width="480" height="40" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;usage shapes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;jobs: reserve the estimate, commit the actual gpu_ms;&lt;br&gt;failed jobs refund automatically&lt;br&gt;sessions: 60 GPU-second chunks, extended while drawing;&lt;br&gt;a failed extension closes the session gracefully,&lt;br&gt;at most one chunk of overdraft&lt;br&gt;insufficient credits answer 402 before any GPU spend&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#c9cdd6;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=left;spacingLeft=14;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="64" y="1004" width="440" height="176" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;when billing is down&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;reserve fails closed: no GPU time is ever granted on credit&lt;br&gt;commit and refund queue in an outbox in the API&amp;#x27;s&lt;br&gt;PostgreSQL and retry until acknowledged&lt;br&gt;at-least-once delivery + unique ledger keys:&lt;br&gt;settlement lands exactly once&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=left;spacingLeft=14;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="528" y="1004" width="448" height="176" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>