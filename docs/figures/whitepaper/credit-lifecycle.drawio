;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=top;spacingTop=40;spacing=10;" vertex="1" parent="1"><mxGeometry x="64" y="904" width="180" height="112" as="geometry"/></mxCell><mxCell id="icon50" value="" style="shape=mxgraph.aws4.traditional_server;fillColor=#2d3142;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="138.0" y="916" width="32" height="32" as="geometry"/></mxCell><mxCell id="put51" value="&lt;b&gt;&lt;span style=&quot;font-family:Courier New&quot;&gt;PUT /v1/reservations/{id}&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#4f5d75&quot;&gt;estimate + TTL, retry-safe on the same id&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="276" y="904" width="252" height="112" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;reserved&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e4e7ec;strokeColor=#8e98ac;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="560" y="904" width="132" height="112" as="geometry"/></mxCell><mxCell id="st53" value="&lt;b&gt;committed&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e3f1e8;strokeColor=#1f7a4d;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#1f7a4d;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="796" y="904" width="180" height="32" as="geometry"/></mxCell><mxCell id="st54" value="&lt;b&gt;refunded&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillC