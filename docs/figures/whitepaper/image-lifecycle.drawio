=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rec17" target="store28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#f5f5f5;endArrow=block;endFill=1;endSize=7;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="store28" target="share26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e33" value="cloud: a five-minute signed URL; local install: the API&#x27;s asset route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4f5d75;strokeWidth=1.4;fontFamily=Lato;fontSize=13;fontColor=#7a8399;labelBackgroundColor=#f5f5f5;endArrow=block;endFill=1;endSize=7;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="store28" target="you11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="905" y="566"/><mxPoint x="135" y="566"/></Array></mxGeometry></mxCell><mxCell id="rt34" value="What the platform keeps, and what it never keeps" style="text;html=1;whiteSpace=wrap;fontFamily=Lato;fontSize=16;fontColor=#2d3142;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="616" width="960" height="22" as="geometry"/></mxCell><mxCell id="kept35" value="&lt;b&gt;Recorded&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;font-weight:normal;color:#2d3142;line-height:1.5&quot;&gt;your image with its parameters (and seed, if you set one), private to you&lt;br&gt;usage rows: which model ran, for how long, and a&lt;br&gt;category label (its CLIP pass is not built: it reads other)&lt;br&gt;your session: an opaque server-side token in an&lt;br&gt;HttpOnly cookie, listable and instantly revocable&lt;/span&gt;" style="spacingTop=44;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e3f1e8;strokeColor=#1f7a4d;strokeWidth=1.2;fontFamily=Lato;fontSize=17;fontColor=#2d3142;fontStyle=0;align=left;verticalAlign=top;spacingLeft=20;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="470" height="200" as="geometry"/></mxCell><mxCell id="icon36" value="" style="shape=mxgraph.aws4.database;fillColor=#1f7a4d;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="662" width="32" height="32" as="geometry"/></mxCell><mxCell id="never37" value="&lt;b&gt;Never kept or used&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;font-weight:normal;color:#2d3142;line-height:1.5&quot;&gt;the prompt, the image or your address in usage rows&lt;br&gt;cookies, trackers, or any client-side analytics&lt;br&gt;prompt text in a strike&lt;br&gt;anything you create, for training models&lt;/span&gt;" style="spacingTop=44;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8e3e3;strokeColor=#b4232a;strokeWidth=1.2;fontFamily=Lato;fontSize=17;fontColor=#2d3142;fontStyle=0;align=left;verticalAlign=top;spacingLeft=20;spacing=10;" vertex="1" parent="1"><mxGeometry x="530" y="650" width="470" height="200" as="geometry"/></mxCell><mxCell id="icon38" value="" style="shape=mxgraph.aws4.ssl_padlock;fillColor=#b4232a;strokeColor=none;aspect=fixed;html=1;" vertex="1" parent="1"><mxGeometry x="550" y="662" width="32" height="32" as="geometry"/></mxCell><mxCell id="selfhost39" value="&lt;b&gt;Self-hosted installs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;font-weight:normal;color:#4f5d75;line-height:1.5&quot;&gt;send one anonymous daily aggregate, previewable locally and disabled with one switch&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eeeff2;strokeColor=#c9cdd6;strokeWidth=1.2;fontFamily=Lato;fontSize=15;fontColor=#2d3142;fontStyle=0;al