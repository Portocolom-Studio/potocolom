{
	"name": "frontend",
	"private": true,
	"version": "0.1.1",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/add-jsonld-csp-hashes.mjs && node scripts/verify-csp.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"test": "node --import ./scripts/node-test-loader.mjs --test \"src/**/*.test.ts\"",
		"test:canvas": "node scripts/test-canvas-history.mjs",
		"test:signin": "node scripts/test-signin-cookie.mjs",
		"test:landing": "node scripts/test-landing-build.mjs",
		"format": "prettier --write .",
		"generate:hero-preview": "node scripts/generate-hero-preview.mjs",
		"generate:gallery-images": "node scripts/generate-gallery-images.mjs",
		"generate:making-images": "node scripts/generate-making-images.mjs",
		"generate:hero-images": "node scripts/generate-hero-images.mjs",
		"compare:collages": "node scripts/compare-collages.mjs"
	},
	"devDependencies": {
		"@fontsource/lato": "^5.3.0",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.24.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.2",
		"@types/d3-hierarchy": "^3.1.7",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.8",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"layerchart": "^2.0.0-next.48",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^4.0.3",
		"puppeteer-core": "^25.12.0",
		"shadcn-svelte": "^1.4.2",
		"sharp": "^0.35.5",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"overrides": {
		"cookie": "^0.7.2",
		"ip-address": "^10.3.1",
		"postcss": "^8.5.24"
	},
	"dependencies": {
		"d3-hierarchy": "^3.1.2"
	}
}
