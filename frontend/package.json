{
	"name": "frontend",
	"private": true,
	"version": "0.1.4",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/add-jsonld-csp-hashes.mjs && node scripts/verify-csp.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"test": "node --import ./scripts/node-test-loader.mjs --test \"src/**/*.test.ts\"",
		"test:canvas": "node scripts/test-canvas-history.mjs",
		"test:footer": "node scripts/test-footer-contrast.mjs",
		"test:signin": "node scripts/test-signin-cookie.mjs",
		"test:setup": "node scripts/test-setup-page.mjs && node scripts/test-setup-handoff.mjs",
		"test:views": "node scripts/test-studio-view-state.mjs",
		"test:tour": "node scripts/test-studio-tour.mjs",
		"test:owner-focus": "node scripts/test-owner-focus.mjs",
		"test:landing": "node scripts/test-landing-build.mjs",
		"test:docs": "node scripts/test-docs-browser.mjs",
		"test:self-hosted": "node scripts/test-self-hosted-build.mjs",
		"test:studio-shell": "node scripts/test-studio-shell.mjs",
		"format": "prettier --write .",
		"generate:hero-preview": "node scripts/generate-hero-preview.mjs",
		"generate:gallery-images": "node scripts/generate-gallery-images.mjs",
		"generate:making-images": "node scripts/generate-making-images.mjs",
		"generate:hero-images": "node scripts/generate-hero-images.mjs",
		"compare:collages": "node scripts/compare-collages.mjs",
		"test:models": "node scripts/test-model-management.mjs && npm run test:models:regressions",
		"test:models:regressions": "for scenario in panel-admin panel-protocol6 panel-viewer panel-offline panel-viewer-offline error-focus footer-focus dismiss-focus unknown-reservation spanish-labels bulk-focus failed-bulk-focus refused-remove-focus unknown-space locale-size wide-grid install-focus preview-transition reserved gated-button; do MODEL_REGRESSION=$scenario node scripts/test-model-management.mjs || exit 1; done"
	},
	"devDependencies": {
		"@fontsource/geist": "^5.3.0",
		"@fontsource/geist-mono": "^5.3.0",
		"@fontsource/lato": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.69.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"@types/d3-hierarchy": "^3.1.7",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"@types/node": "^26.6.6",
		"bits-ui": "^2.20.6",
		"clsx": "^2.1.1",
		"layerchart": "^2.9.2",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.0.3",
		"puppeteer-core": "^25.12.0",
		"shadcn-svelte": "^1.8.0",
		"sharp": "^0.35.5",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.6"
	},
	"overrides": {
		"cookie": "^0.7.2",
		"ip-address": "^10.3.1",
		"postcss": "^8.5.24"
	},
	"dependencies": {
		"d3-hierarchy": "^3.1.3",
		"marked": "^18.1.3"
	}
}
